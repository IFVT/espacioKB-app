# Copiar a .env.local y rellenar. NUNCA subir el archivo con valores reales.
# En Vercel se cargan en Settings → Environment Variables.

# --- Supabase ---
SUPABASE_URL=
# service_role key: solo servidor, salta RLS. Jamás exponerla al navegador.
SUPABASE_SERVICE_KEY=

# --- Mercado Pago ---
MP_ACCESS_TOKEN=

# --- Bold (pendiente de integrar) ---
BOLD_API_KEY=
BOLD_SECRET_KEY=

# --- Google (cuenta de servicio con Calendar + Sheets, pendiente) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEET_ID=

# --- Correo (pendiente) ---
RESEND_API_KEY=
NOTIFY_EMAIL=

# --- App ---
# URL pública del despliegue, sin barra final. La usan las back_urls y el
# notification_url de Mercado Pago.
PUBLIC_BASE_URL=https://reservas.espaciokb.org
